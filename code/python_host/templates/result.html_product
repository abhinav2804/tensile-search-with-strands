                    }
                ]
            },
            'Show me laptops with 16GB RAM, Intel i7 processor, under 80000 rupees, with SSD storage, good for gaming and video editing': {
                category: "Electronics & Tech",
                resultCount: 6,
                summary: "Found 6 high-performance laptops with Intel i7 processors, 16GB RAM, and SSD storage optimized for gaming and video editing within your budget.",
                details: "Our search identified powerful laptops from leading brands including ASUS, HP, and Dell that meet your performance specifications. All models feature Intel i7 processors (10th gen or newer), 16GB RAM, SSD storage, and dedicated graphics cards suitable for gaming and video editing tasks.",
                highlights: "Top matches include gaming laptops with NVIDIA RTX graphics, high refresh rate displays, advanced cooling systems, and professional-grade video editing capabilities. All models support 4K video rendering and modern gaming at high settings.",
                priceRange: "₹65,999 - ₹79,999",
                products: [
                    { 
                        name: "ASUS ROG Strix G15", 
                        brand: "ASUS", 
                        price: "₹74,999", 
