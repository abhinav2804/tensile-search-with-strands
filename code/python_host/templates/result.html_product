                    },
                    { 
                        name: "ASUS TUF Gaming A15", 
                        brand: "ASUS", 
                        price: "₹69,999", 
                        features: "Intel i7-11370H, 16GB RAM, 1TB SSD, RTX 3050",
                        rating: "4.6",
                        badges: ["Durable", "Gaming Ready"]
                    },
                    { 
                        name: "HP Omen 15", 
                        brand: "HP", 
                        price: "₹76,999", 
                        features: "Intel i7-11800H, 16GB RAM, 512GB SSD, RTX 3060",
                        rating: "4.5",
                        badges: ["High Performance", "Premium"]
                    },
                    { 
                        name: "Lenovo Legion 5", 
                        brand: "Lenovo", 
                        price: "₹71,999", 
                        features: "Intel i7-10750H, 16GB RAM, 1TB SSD, RTX 3050Ti",
                        rating: "4.3",
                        badges: ["Gaming", "Value Pick"]
                    }
                ]
            },
            'Find wireless headphones with active noise cancellation, over 20 hours battery life, under 5000 rupees, compatible with both Android and iPhone': {
                category: "Audio Equipment",
                resultCount: 5,
                summary: "Found 5 premium wireless headphones with active noise cancellation, 20+ hours battery life, and universal device compatibility within your budget.",
                details: "Our search identified high-quality wireless headphones from Sony, JBL, and other trusted brands featuring active noise cancellation technology, extended battery life exceeding 25 hours, and seamless compatibility with both Android and iPhone devices via Bluetooth 5.0+.",
                highlights: "Top matches include industry-leading noise cancellation technology, quick charge capabilities, premium audio drivers, and comprehensive warranty coverage. All products support voice assistants and hands-free calling.",
                priceRange: "₹3,999 - ₹4,999",
                products: [
                    { 
                        name: "Sony WH-CH720N", 
                        brand: "Sony", 
                        price: "₹4,799", 
                        features: "Active Noise Cancelling, 35Hr Battery, Quick Charge",
                        rating: "4.4",
                        badges: ["Premium", "ANC"]
                    },
                    { 
                        name: "JBL Tune 760NC", 
                        brand: "JBL", 
                        price: "₹4,299", 
                        features: "ANC, 35Hr Playtime, Pure Bass Sound",
                        rating: "4.3",
                        badges: ["Best Value", "Long Battery"]
                    },
                    { 
                        name: "Audio-Technica ATH-ANC500BT", 
                        brand: "Audio-Technica", 
                        price: "₹4,999", 
                        features: "QuietPoint ANC, 25Hr Battery, Hi-Res Audio",
                        rating: "4.5",
                        badges: ["Premium", "Hi-Res"]
                    },
                    { 
                        name: "Sennheiser HD 350BT", 
                        brand: "Sennheiser", 
                        price: "₹4,599", 
                        features: "Bluetooth 5.0, 30Hr Battery, Foldable Design",
                        rating: "4.6",
                        badges: ["Premium", "Durable"]
                    },
                    { 
                        name: "Boat Nirvana 751 ANC", 
                        brand: "Boat", 
                        price: "₹3,999", 
                        features: "Hybrid ANC, 54Hr Playtime, ASAP Charge",
                        rating: "4.2",
                        badges: ["Budget Friendly", "Long Battery"]
                    }
                ]
            }
        };

        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            loadQueryResults();
            initializeSearchForm();
        });

        function loadQueryResults() {
            const urlParams = new URLSearchParams(window.location.search);
            const query = urlParams.get('q') || localStorage.getItem('currentQuery') || 'Find me a high-quality product with specific features...';
            
            // Update query display
            document.getElementById('queryText').textContent = query;

            // Find matching template result or use default
            let resultData = templateResults[query];
            
            if (!resultData) {
                // Generate generic results for non-template queries
                resultData = generateGenericResults(query);
            }

            // Populate results after small delay for loading effect
            setTimeout(() => {
                populateResults(resultData);
            }, 1500);
        }

        function generateGenericResults(query) {
            const categories = [
                { name: "Electronics & Tech" },
                { name: "Fashion & Apparel" },
                { name: "Home & Furniture" },
                { name: "Sports & Fitness" },
                { name: "Audio Equipment" }
            ];
            
            const randomCategory = categories[Math.floor(Math.random() * categories.length)];
            const resultCount = Math.floor(Math.random() * 5) + 3;
            
            return {
                category: randomCategory.name,
                resultCount: resultCount,
                summary: `Found ${resultCount} products matching your search criteria with verified quality and competitive pricing.`,
                details: "Our AI-powered search analyzed your requirements and identified products from trusted brands with high customer ratings and reliable availability.",
                highlights: "Top matches include products with excellent customer reviews, warranty coverage, and competitive pricing from authorized retailers.",
                priceRange: "₹1,999 - ₹15,999",
                products: [
                    { 
                        name: "Premium Product Match", 
                        brand: "Top Brand", 
                        price: "₹8,999", 
                        features: "Advanced Features, Premium Quality",
                        rating: "4.5",
                        badges: ["Premium", "Top Rated"]
                    },
                    { 
                        name: "Value Product Option", 
                        brand: "Trusted Brand", 
                        price: "₹5,499", 
                        features: "Essential Features, Good Quality",
                        rating: "4.2",
                        badges: ["Best Value", "Popular"]
                    },
                    { 
                        name: "Professional Grade Product", 
                        brand: "Pro Brand", 
                        price: "₹12,999", 
                        features: "Professional Grade, Enhanced Performance",
                        rating: "4.7",
                        badges: ["Professional", "Premium"]
                    }
                ]
            };
        }

        function populateResults(data) {
            // Update category and results info
            document.getElementById('categoryBadge').textContent = data.category;
            document.getElementById('resultCount').textContent = `${data.resultCount} Results`;

            // Update content sections
            document.getElementById('summaryText').textContent = data.summary;
            document.getElementById('detailsText').textContent = data.details;
            document.getElementById('highlightsText').textContent = data.highlights;

            // Update price range
            const priceRangeElement = document.getElementById('priceRange');
            priceRangeElement.textContent = `Price Range: ${data.priceRange}`;
            priceRangeElement.style.display = 'inline-block';

            // Generate product table
            const productTable = document.getElementById('productTable');
            if (productTable) {
                const tbody = productTable.querySelector('tbody');
                tbody.innerHTML = generateProductTableRows(data.products);
            } else {
                console.error('Product table element not found');
            }
        }

        function generateProductTableRows(products) {
            return products.map(product => `
                <tr>
                    <td class="product-name-cell">${product.name}</td>
                    <td class="brand-cell">${product.brand}</td>
                    <td class="features-cell">${product.features}</td>
                    <td class="rating-cell">${product.rating}/5</td>
                    <td class="price-cell">${product.price}</td>
                </tr>
            `).join('');
        }

        function initializeSearchForm() {
            const searchForm = document.getElementById('searchForm');
            const userInput = document.getElementById('userInput');
            const submitBtn = document.getElementById('submitBtn');

            // Form submission
            searchForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const query = userInput.value.trim();
                if (query) {
                    // Redirect to new search with updated query
                    const params = new URLSearchParams({
                        q: query,
                        category: document.getElementById('categorySelector').value,
                        timestamp: Date.now()
                    });
                    window.location.href = `result.html?${params.toString()}`;
                }
            });

            // Input validation
            userInput.addEventListener('input', () => {
                submitBtn.disabled = !userInput.value.trim();
            });

            // Initial button state
            submitBtn.disabled = !userInput.value.trim();
        }
    </script>
</body>
</html>
