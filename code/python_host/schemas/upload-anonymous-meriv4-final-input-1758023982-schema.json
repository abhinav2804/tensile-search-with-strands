            "min_gram": 2,
            "max_gram": 10
          }
        }
      }
    },
    "mappings": {
      "dynamic_templates": [
        {
          "strings_as_searchable": {
            "match_mapping_type": "string",
            "match": "*name*|*title*|*description*|*content*|*text*|*note*|*comment*",
            "mapping": {
              "type": "text",
              "analyzer": "custom_text_analyzer",
              "search_analyzer": "standard",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                },
                "autocomplete": {
                  "type": "text",
                  "analyzer": "autocomplete_analyzer"
                }
              }
            }
          }
        },
        {
          "strings_as_keywords": {
            "match_mapping_type": "string",
            "match": "*_id|*code*|*sku*|*isbn*|*account*",
            "mapping": {
              "type": "keyword"
            }
          }
        },
        {
          "dates_detection": {
            "match": "*date*|*time*|created*|updated*|modified*",
            "mapping": {
              "type": "date",
              "format": "yyyy-MM-dd||yyyy-MM-dd HH:mm:ss||epoch_millis||strict_date_optional_time"
            }
          }
        },
        {
          "numbers_as_scaled": {
            "match_mapping_type": "long",
            "match": "*price*|*cost*|*amount*|*fee*|*salary*",
            "mapping": {
              "type": "scaled_float",
              "scaling_factor": 100
            }
          }
        }
      ],
      "properties": {
        "q": {
          "type": "text",
          "analyzer": "custom_text_analyzer",
          "search_analyzer": "standard",
          "fields": {
            "keyword": {
