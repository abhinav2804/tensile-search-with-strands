              "search_analyzer": "standard"
            },
            "exact": {
              "type": "text",
              "analyzer": "keyword"
            }
          }
        },
        "isq": {
          "type": "text",
          "analyzer": "custom_text_analyzer",
          "search_analyzer": "standard",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 512
            },
            "autocomplete": {
              "type": "text",
              "analyzer": "autocomplete_analyzer",
              "search_analyzer": "standard"
            },
            "exact": {
              "type": "text",
              "analyzer": "keyword"
            }
          }
        },
        "display_id": {
          "type": "keyword",
          "ignore_above": 65,
