<!-- Enhanced Input Section -->
<div class="input-section">
    <div class="input-container">
        <div class="dropdown-container">
            <select id="indexSelector" class="dropdown">
                <option value="auto">AI Choice</option>
                <option value="logs-*">logs-*</option>
                <option value="metrics-*">metrics-*</option>
                <option value="filebeat-*">filebeat-*</option>
                <option value="metricbeat-*">metricbeat-*</option>
                <option value="winlogbeat-*">winlogbeat-*</option>
                <option value="auditbeat-*">auditbeat-*</option>
                <option value="packetbeat-*">packetbeat-*</option>
                <option value="custom-index">Custom Index</option>
            </select>
        </div>
        
        <input id="userInput" class="main-input" type="text" placeholder="Ask me anything about your ElasticSearch data..." />
        
        <button id="submitBtn" class="submit-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 2L11 13"/>
                <path d="M22 2l-7 20-4-9-9-4 20-7z"/>
            </svg>
        </button>
    </div>
</div>

<script>
    // Typewriter effect for subtitle
    const phrases = [
        "AI Powered Search",
        "Model Context Protocol", 
        "Elastic Search"
    ];
    
    let currentPhrase = 0;
    let currentChar = 0;
    let isDeleting = false;
    
    function typeWriter() {
        const typewriterElement = document.getElementById('typewriter');
        if (!typewriterElement) return;
        
        const current = phrases[currentPhrase];
        
        if (isDeleting) {
            typewriterElement.textContent = current.substring(0, currentChar - 1);
            currentChar--;
        } else {
            typewriterElement.textContent = current.substring(0, currentChar + 1);
            currentChar++;
        }
        
        let typeSpeed = isDeleting ? 80 : 120;
        
        if (!isDeleting && currentChar === current.length) {
            typeSpeed = 1500; // Pause at end
            isDeleting = true;
        } else if (isDeleting && currentChar === 0) {
            isDeleting = false;
            currentPhrase = (currentPhrase + 1) % phrases.length;
            typeSpeed = 300; // Pause before next phrase
        }
        
        setTimeout(typeWriter, typeSpeed);
    }
    
    // Start typewriter effect when DOM is ready
    document.addEventListener('DOMContentLoaded', function() {
        setTimeout(typeWriter, 500);
    });
	
    // Template click → fill input
    document.querySelectorAll('.template-card').forEach(card => {
        card.addEventListener('click', () => {
            const prompt = card.getAttribute('data-prompt');
            document.querySelector('.main-input').value = prompt;
            document.querySelector('.main-input').focus();
        });
    });

    // Submit button progress animation
    const submitBtn = document.querySelector('.submit-btn');
    const progressBar = submitBtn.querySelector('.progress-bar');
    const mainInput = document.querySelector('.main-input');
    let progressInterval;

    submitBtn.addEventListener("click", () => {
        if (!mainInput.value.trim()) return;
        let progress = 0;
        clearInterval(progressInterval);
        progressInterval = setInterval(() => {
            progress += 5;
            if (progress > 100) progress = 0;
            progressBar.style.width = progress + "%";
        }, 200);

        // ⚠️ Replace with your real search logic
        setTimeout(() => {
            clearInterval(progressInterval);
            progressBar.style.width = "0%";
            alert("Executed query: " + mainInput.value);
        }, 5000);
    });
</script>
</body>
</html>

