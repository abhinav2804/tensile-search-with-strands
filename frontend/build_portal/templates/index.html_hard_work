// ================== SIMPLIFIED EMAIL AUTHENTICATION SYSTEM ==================
class EmailAuthManager {
    constructor() {
        this.currentUser = null;
        this.isAuthenticated = false;
        this.API_ENDPOINT = 'http://35.244.59.108:5678/webhook/es_mcp';
        
        this.initializeAuth();
        this.setupEventListeners();
    }

    initializeAuth() {
        // Check for existing session
        const storedUser = this.getStoredUser();
        if (storedUser && this.isValidSession(storedUser)) {
            this.setUser(storedUser);
        }

        // Setup Descope event listeners with proper error handling
        this.setupDescopeListeners();
    }

    setupDescopeListeners() {
        // Wait for Descope component to load
        setTimeout(() => {
            const descopeWc = document.querySelector('descope-wc');
            if (descopeWc) {
                // Success event
                descopeWc.addEventListener('success', (e) => {
                    console.log('Descope success event:', e.detail);
                    this.handleAuthSuccess(e.detail);
                });

                // Error event
                descopeWc.addEventListener('error', (e) => {
                    console.error('Descope error event:', e.detail);
                    this.handleAuthError(e.detail);
                });

                // Ready event
                descopeWc.addEventListener('ready', () => {
                    console.log('Descope component ready');
                });

            } else {
                console.warn('Descope component not found, retrying...');
                setTimeout(() => this.setupDescopeListeners(), 1000);
            }
        }, 1000);
    }

    setupEventListeners() {
        // Login button
        document.getElementById('loginBtn')?.addEventListener('click', () => {
            this.showAuthModal();
        });

        // Auth prompt button
        document.getElementById('authPromptBtn')?.addEventListener('click', () => {
            this.showAuthModal();
        });

        // Logout button
        document.getElementById('logoutBtn')?.addEventListener('click', () => {
            this.logout();
        });

        // Close modal button
        document.getElementById('closeModal')?.addEventListener('click', () => {
            this.hideAuthModal();
        });

        // Close modal on background click
        document.getElementById('authModal')?.addEventListener('click', (e) => {
            if (e.target.id === 'authModal') {
                this.hideAuthModal();
            }
        });

        // Close protected overlay on background click
        document.getElementById('protectedOverlay')?.addEventListener('click', (e) => {
            if (e.target.id === 'protectedOverlay') {
                this.hideProtectedOverlay();
            }
        });

        // Close protected overlay on escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                this.hideProtectedOverlay();
                this.hideAuthModal();
            }
        });
    }

    handleAuthSuccess(authData) {
        console.log('Processing auth success:', authData);
        
        // Extract user information from Descope response
        const userData = authData.user || {};
        const sessionData = authData.sessionJwt || authData.sessionToken || '';
        
        const user = {
            id: userData.userId || userData.id || 'user-' + Date.now(),
            name: userData.name || userData.givenName || userData.email?.split('@')[0] || 'User',
            email: userData.email || '',
            token: sessionData,
            loginTime: Date.now()
        };

        console.log('Created user object:', user);
        
        this.setUser(user);
        this.storeUser(user);
        this.hideAuthModal();
        this.hideProtectedOverlay();
        
        // Show success notification
        this.showNotification('Successfully signed in! Welcome to Product Discovery AI.', 'success');
    }

    handleAuthError(error) {
        console.error('Authentication error details:', error);
        
        let errorMessage = 'Authentication failed. Please try again.';
        
        // Handle specific error types
        if (error.errorCode) {
            switch (error.errorCode) {
                case 'InvalidCredentials':
                    errorMessage = 'Invalid email or password. Please check your credentials.';
                    break;
                case 'UserNotFound':
                    errorMessage = 'User not found. Please sign up first.';
                    break;
                case 'NetworkError':
                    errorMessage = 'Network error. Please check your connection.';
                    break;
                default:
                    errorMessage = error.errorMessage || errorMessage;
            }
        }
        
        this.showNotification(errorMessage, 'error');
    }

    setUser(user) {
        this.currentUser = user;
        this.isAuthenticated = true;
        this.updateUI();
        console.log('User set successfully:', user);
    }

    logout() {
        this.currentUser = null;
        this.isAuthenticated = false;
        this.clearStoredUser();
        this.updateUI();
        this.showNotification('You have been signed out successfully.', 'info');
    }

    updateUI() {
        const userInfo = document.getElementById('userInfo');
        const loginBtn = document.getElementById('loginBtn');
        const userAvatar = document.getElementById('userAvatar');
        const userName = document.getElementById('userName');

        if (this.isAuthenticated && this.currentUser) {
            // Show user info, hide login button
            userInfo.style.display = 'flex';
            loginBtn.style.display = 'none';
            
            // Update user display
            const initials = this.getInitials(this.currentUser.name);
            userAvatar.textContent = initials;
            userName.textContent = this.currentUser.name;
        } else {
            // Show login button, hide user info
            userInfo.style.display = 'none';
            loginBtn.style.display = 'inline-block';
        }

        // Update input state
        this.updateInputState();
    }

    getInitials(name) {
        return name
            .split(' ')
            .map(word => word.charAt(0).toUpperCase())
            .slice(0, 2)
            .join('');
    }

    showAuthModal() {
        document.getElementById('authModal').classList.add('active');
    }

    hideAuthModal() {
        document.getElementById('authModal').classList.remove('active');
    }

    showProtectedOverlay() {
        const overlay = document.getElementById('protectedOverlay');
        if (overlay) {
            overlay.style.display = 'flex';
        }
    }

    hideProtectedOverlay() {
        const overlay = document.getElementById('protectedOverlay');
        if (overlay) {
            overlay.style.display = 'none';
        }
    }

    requireAuth(callback) {
        if (this.isAuthenticated) {
            callback();
        } else {
            this.showProtectedOverlay();
        }
    }

    updateInputState() {
        const inputContainer = document.querySelector('.input-container');
        const userInput = document.getElementById('userInput');
        
        if (this.isAuthenticated) {
            inputContainer.style.opacity = '1';
            userInput.placeholder = 'Describe the product you\'re looking for with specific details...';
        } else {
            inputContainer.style.opacity = '0.8';
            userInput.placeholder = 'Sign in to unlock product search functionality...';
        }
    }

    storeUser(user) {
        try {
            const userData = {
                ...user,
                timestamp: Date.now()
            };
            // Using session storage fallback since localStorage is not available
            window._userSession = userData;
        } catch (error) {
            console.warn('Could not store user session:', error);
        }
    }

    getStoredUser() {
        try {
            return window._userSession || null;
        } catch (error) {
            console.warn('Could not retrieve user session:', error);
            return null;
        }
    }

    clearStoredUser() {
        try {
            delete window._userSession;
        } catch (error) {
            console.warn('Could not clear user session:', error);
        }
    }

    isValidSession(user) {
        if (!user || !user.timestamp) return false;
        
        // Session expires after 24 hours
        const sessionDuration = 24 * 60 * 60 * 1000;
        return (Date.now() - user.timestamp) < sessionDuration;
    }

    async makeAPICall(query, category) {
        if (!this.isAuthenticated) {
            throw new Error('Authentication required');
        }

        const requestData = {
            chatInput: query,
            category: category,
            userId: this.currentUser?.id,
            timestamp: Date.now()
        };


        console.log('Making API call to:', this.API_ENDPOINT);
        console.log('Request data:', requestData);

	const controller = new AbortController();
	const id = setTimeout(() => controller.abort(), 120000);

        try {
            const response = await fetch(this.API_ENDPOINT, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${this.currentUser?.token || ''}`,
                },
                body: JSON.stringify(requestData),
		signal: controller.signal
                
            });

            if (!response.ok) {
			    console.log(response);
                throw new Error(`HTTP error! status: ${response.status}`);
            }

            const data = await response.json();
            console.log('API Response:', data);
            return data;

        } catch (error) {
            console.error('API call failed:', error);
            throw error;
        }
	clearTimeout(id);
    }

    showNotification(message, type = 'info') {
        // Create notification element
        const notification = document.createElement('div');
        notification.style.cssText = `
            position: fixed;
            top: 100px;
            right: 20px;
            background: ${type === 'success' ? 'linear-gradient(135deg, #10b981, #059669)' : 
                        type === 'error' ? 'linear-gradient(135deg, #ef4444, #dc2626)' : 
                        'linear-gradient(135deg, #3b82f6, #1d4ed8)'};
            color: white;
            padding: 1rem 1.5rem;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            z-index: 10000;
            font-size: 0.9rem;
            font-weight: 600;
            max-width: 350px;
            opacity: 0;
            transform: translateX(100px);
            transition: all 0.3s ease;
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        `;
        
        notification.textContent = message;
        document.body.appendChild(notification);

        // Animate in
        setTimeout(() => {
            notification.style.opacity = '1';
            notification.style.transform = 'translateX(0)';
        }, 100);

        // Remove after 4 seconds
        setTimeout(() => {
            notification.style.opacity = '0';
            notification.style.transform = 'translateX(100px)';
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.parentNode.removeChild(notification);
                }
            }, 300);
        }, 4000);
    }
}

