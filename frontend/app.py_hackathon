@app.route('/remote-instances/<instance_name>/stop', methods=['POST'])
@login_required
def stop_remote_instance(instance_name):
    """Stop a remote Elasticsearch instance"""
    try:
        if pipeline is None:
            return jsonify({'error': 'Pipeline not initialized'}), 500
        
        success = pipeline.stop_remote_instance(instance_name)
        
        if success:
            return jsonify({
                'success': True,
                'message': f'Instance {instance_name} stopped successfully'
            })
        else:
            return jsonify({
                'success': False,
                'error': f'Failed to stop instance {instance_name}'
            }), 500
            
    except Exception as e:
        print(f"Error stopping remote instance: {e}")
        return jsonify({'error': str(e)}), 500

