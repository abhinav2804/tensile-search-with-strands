        return jsonify({'error': 'Job not found'}), 404
    
    return jsonify(processing_status[job_id])

@app.route('/jobs', methods=['GET'])
@login_required
def list_jobs():
    """List all processing jobs for current user"""
    user_id = session.get('user', {}).get('id', 'anonymous')
    user_jobs = {
        job_id: status for job_id, status in processing_status.items() 
        if status.get('user_id') == user_id
    }
    return jsonify(user_jobs)

@app.route('/indices', methods=['GET'])
def list_indices():
    """List all Elasticsearch indices"""
    try:
        if pipeline is None:
            return jsonify({'error': 'Pipeline not initialized'}), 500
            
        indices_info = pipeline.es_manager.es.cat.indices(format='json')
        
        our_indices = [
            {
                'index': idx['index'],
                'docs_count': idx.get('docs.count', '0'),
                'store_size': idx.get('store.size', '0b'),
                'health': idx.get('health', 'unknown')
            }
            for idx in indices_info 
            if idx['index'].startswith('upload-') or idx['index'].startswith('index-')
        ]
        
        return jsonify({
            'indices': our_indices,
            'total_count': len(our_indices)
        })
        
    except Exception as e:
        print(f"Error listing indices: {e}")
        return jsonify({'error': str(e)}), 500

@app.route('/search/<index_name>', methods=['GET'])
def search_index(index_name):
    """Search documents in an index"""
    try:
        if pipeline is None:
            return jsonify({'error': 'Pipeline not initialized'}), 500
            
        size = request.args.get('size', 10, type=int)
        query = request.args.get('q', '*')
        
        search_body = {
            'query': {
                'query_string': {
                    'query': query
                }
            },
            'size': min(size, 100)
        }
        
        result = pipeline.es_manager.es.search(
            index=index_name,
            body=search_body
        )
        
        return jsonify({
            'total_hits': result['hits']['total']['value'] if isinstance(result['hits']['total'], dict) else result['hits']['total'],
            'documents': [hit['_source'] for hit in result['hits']['hits']],
            'took': result['took']
        })
        
    except Exception as e:
        print(f"Search error: {e}")
        return jsonify({'error': str(e)}), 500

