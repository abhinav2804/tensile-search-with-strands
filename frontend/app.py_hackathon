@app.route('/schema-info/<index_name>', methods=['GET'])
def get_schema_info(index_name):
    """Get schema and auto-queries information for an index"""
    try:
        schema_file = f"schemas/{index_name}-schema.json"
        
        if not os.path.exists(schema_file):
            return jsonify({'error': 'Schema file not found'}), 404
        
        # Load schema data
        with open(schema_file, 'r') as f:
            schema_data = json.load(f)
        
        return jsonify({
            'schema': schema_data.get('schema', {}),
            'auto_queries': schema_data.get('auto_queries', []),
            'generated_at': schema_data.get('generated_at'),
            'query_count': len(schema_data.get('auto_queries', []))
        })
        
    except Exception as e:
        print(f"Error getting schema info: {e}")
        return jsonify({'error': str(e)}), 500

