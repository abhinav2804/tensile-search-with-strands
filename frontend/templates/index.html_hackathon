        if (result.success) {
            authManager.showNotification(`Instance ${instanceName} stopped successfully`, 'success');
        } else {
            authManager.showNotification(`Failed to stop instance: ${result.error}`, 'error');
        }
        return result.success;
    } catch (error) {
        console.error('Error stopping remote instance:', error);
        authManager.showNotification('Error stopping instance', 'error');
        return false;
    }
};

