// Enhanced upload function with all new features
async function simulateAuthenticatedUploadEnhanced(files, description, userQueries, deploymentOption) {
    try {
        const formData = new FormData();
        
        files.forEach((file) => {
            const actualFile = new File([file.content], file.name, { type: file.type });
            formData.append('files', actualFile);
        });
        
        // Add enhanced form data
        formData.append('description', description);
        formData.append('userQueries', userQueries);
        formData.append('deployment', deploymentOption);
        
        console.log('Sending enhanced upload request...');
        console.log(`Deployment target: ${deploymentOption}`);
        console.log(`User queries provided: ${userQueries ? userQueries.split('\n').length : 0} lines`);
        
        const response = await fetch('/upload', {
            method: 'POST',
            body: formData,
            headers: {
                'Authorization': `Bearer ${authManager.currentUser?.token || ''}`
            }
        });
        
        if (!response.ok) {
            const text = await response.text();
            throw new Error(`Upload failed: ${response.status} - ${text}`);
        }
        
        const result = await response.json();
        console.log('Enhanced upload successful:', result);
        
        return result;
        
    } catch (error) {
        console.error('Enhanced upload error:', error);
        throw error;
    }
}

