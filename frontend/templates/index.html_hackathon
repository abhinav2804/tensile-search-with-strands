<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Product Discovery AI - Smart Shopping Interface</title>
<meta name="description" content="AI-powered product discovery with natural language search and advanced filtering" />

<!-- Descope Web Component -->
<script src="https://unpkg.com/@descope/web-component@latest/dist/index.js"></script>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        background: linear-gradient(135deg,
            #0a0a0f 0%,
            #1a0f2e 15%,
            #0f1419 30%,
            #1e1b4b 45%,
            #312e81 60%,
            #1e1b4b 75%,
            #0f1419 90%,
            #0a0a0f 100%);
        background-size: 400% 400%;
        animation: backgroundMove 15s ease infinite;
        min-height: 100vh;
        overflow-x: hidden;
        position: relative;
        background-attachment: fixed;
    }

    @keyframes backgroundMove {
        0%, 100% { background-position: 0% 50%; }
        25% { background-position: 100% 25%; }
        50% { background-position: 50% 100%; }
        75% { background-position: 25% 75%; }
    }

    body::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background:
            radial-gradient(ellipse at 15% 20%, rgba(139, 92, 246, 0.3) 0%, transparent 50%),
            radial-gradient(ellipse at 85% 30%, rgba(59, 130, 246, 0.25) 0%, transparent 45%),
            radial-gradient(ellipse at 50% 90%, rgba(16, 185, 129, 0.2) 0%, transparent 60%),
            radial-gradient(ellipse at 70% 10%, rgba(236, 72, 153, 0.15) 0%, transparent 40%),
            radial-gradient(ellipse at 30% 70%, rgba(168, 85, 247, 0.2) 0%, transparent 55%);
        animation: backgroundShift 25s ease-in-out infinite;
        z-index: 0;
    }

    @keyframes backgroundShift {
        0%, 100% {
            opacity: 0.7;
            transform: scale(1) rotate(0deg);
        }
        25% {
            opacity: 0.9;
            transform: scale(1.05) rotate(1deg);
        }
        50% {
            opacity: 0.6;
            transform: scale(0.95) rotate(-0.8deg);
        }
        75% {
            opacity: 0.8;
            transform: scale(1.02) rotate(1.2deg);
        }
    }

    /* Authentication Header */
    .auth-header {
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 1000;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: linear-gradient(145deg,
            rgba(17, 24, 39, 0.95) 0%,
            rgba(30, 41, 59, 0.85) 100%);
        border: 1px solid rgba(139, 92, 246, 0.3);
        border-radius: 50px;
        padding: 0.75rem 1.25rem;
        backdrop-filter: blur(25px);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    }

    .user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, #8b5cf6, #3b82f6);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 0.875rem;
    }

    .user-name {
        color: #e2e8f0;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .auth-btn {
        background: linear-gradient(135deg, #8b5cf6, #3b82f6);
        color: white;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 25px;
        cursor: pointer;
        font-size: 0.875rem;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3);
    }

    .auth-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(139, 92, 246, 0.4);
    }

    .logout-btn {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
    }

    .logout-btn:hover {
        box-shadow: 0 8px 25px rgba(239, 68, 68, 0.4);
    }

    /* Login Modal Overlay */
    .auth-modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(10px);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
    }

    .auth-modal.active {
        opacity: 1;
        visibility: visible;
    }

    .auth-modal-content {
        background: linear-gradient(145deg,
            rgba(17, 24, 39, 0.95) 0%,
            rgba(30, 41, 59, 0.90) 100%);
        border: 1px solid rgba(139, 92, 246, 0.3);
        border-radius: 20px;
        padding: 2rem;
        max-width: 450px;
        width: 90vw;
        backdrop-filter: blur(25px);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
        position: relative;
        transform: scale(0.9);
        transition: transform 0.3s ease;
    }

    .auth-modal.active .auth-modal-content {
        transform: scale(1);
    }

    .auth-modal-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: none;
        border: none;
        color: #94a3b8;
        font-size: 1.5rem;
        cursor: pointer;
        transition: color 0.3s ease;
    }

    .auth-modal-close:hover {
        color: #e2e8f0;
    }

    .auth-modal-logo {
        display: flex;
        justify-content: center;
        margin-bottom: 1.5rem;
    }

    .auth-modal-logo img {
        width: 80px;
        height: 80px;
        border-radius: 16px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
        object-fit: cover;
    }

    .auth-modal-title {
        color: #f1f5f9;
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        text-align: center;
        background: linear-gradient(135deg, #38bdf8, #8b5cf6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .auth-modal-description {
        color: #94a3b8;
        text-align: center;
        margin-bottom: 2rem;
        line-height: 1.6;
    }

    /* Protected Content Overlay */
    .protected-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(5px);
        z-index: 150;
        display: none;
        align-items: center;
        justify-content: center;
    }

    .protected-message {
        background: linear-gradient(145deg,
            rgba(17, 24, 39, 0.95) 0%,
            rgba(30, 41, 59, 0.90) 100%);
        border: 1px solid rgba(139, 92, 246, 0.3);
        border-radius: 20px;
        padding: 2rem;
        text-align: center;
        backdrop-filter: blur(25px);
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
        max-width: 400px;
        width: 90vw;
    }

    .protected-message h3 {
        color: #f1f5f9;
        font-size: 1.3rem;
        margin-bottom: 1rem;
        background: linear-gradient(135deg, #38bdf8, #8b5cf6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .protected-message p {
        color: #94a3b8;
        margin-bottom: 1.5rem;
        line-height: 1.6;
    }

    /* Enhanced particle system */
    .particle {
        position: fixed;
        border-radius: 50%;
        z-index: 1;
        animation: float 12s infinite linear;
        filter: blur(0.5px);
    }

    .particle:nth-child(1) {
        width: 4px;
        height: 4px;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.6), rgba(139, 92, 246, 0.2));
        box-shadow: 0 0 12px rgba(139, 92, 246, 0.4);
    }

    .particle:nth-child(2) {
        width: 3px;
        height: 3px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.5), rgba(59, 130, 246, 0.1));
        box-shadow: 0 0 10px rgba(59, 130, 246, 0.3);
        animation-duration: 16s;
    }

    .particle:nth-child(3) {
        width: 5px;
        height: 5px;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.6), rgba(16, 185, 129, 0.2));
        box-shadow: 0 0 15px rgba(16, 185, 129, 0.4);
        animation-duration: 14s;
    }

    @keyframes float {
        0% {
            transform: translateY(100vh) scale(0);
            opacity: 0;
        }
        10% {
            opacity: 1;
        }
        90% {
            opacity: 1;
        }
        100% {
            transform: translateY(-10px) scale(1);
            opacity: 0;
        }
    }

    .main-container {
        position: relative;
        z-index: 10;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        padding: 2rem;
        padding-bottom: 140px;
    }

    .header {
        text-align: center;
        margin-bottom: 2rem;
        animation: fadeInDown 1s ease-out;
    }

    @keyframes fadeInDown {
        from { opacity: 0; transform: translateY(-30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .title {
        font-size: 2.8rem;
        font-weight: 700;
        background: linear-gradient(135deg, #38bdf8, #8b5cf6, #10b981);
        background-size: 200% 200%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.5rem;
        animation: gradientFlow 3s ease-in-out infinite;
    }

    @keyframes gradientFlow {
        0%, 100% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
    }

    .subtitle {
        font-size: 1rem;
        color: #94a3b8;
        margin-bottom: 1.5rem;
        height: 1.2em;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .typewriter {
        display: inline-block;
        position: relative;
    }

    .typewriter::after {
        content: '|';
        color: #8b5cf6;
        animation: blink 1s infinite;
        font-weight: bold;
    }

    @keyframes blink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
    }

    /* Enhanced Real-time stats section */
    .stats-section {
        max-width: 1000px;
        margin: 0 auto 3rem auto;
        width: 100%;
        animation: fadeInUp 1s ease-out 0.2s both;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.2rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: linear-gradient(145deg,
            rgba(17, 24, 39, 0.85) 0%,
            rgba(30, 41, 59, 0.75) 100%);
        border: 1px solid rgba(139, 92, 246, 0.25);
        border-radius: 18px;
        padding: 1.8rem;
        text-align: center;
        backdrop-filter: blur(20px);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg,
            transparent,
            rgba(139, 92, 246, 0.8),
            rgba(59, 130, 246, 0.8),
            rgba(16, 185, 129, 0.8),
            transparent);
        animation: shimmer 3s ease-in-out infinite;
    }

    @keyframes shimmer {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
    }

    .stat-card:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 20px 60px rgba(139, 92, 246, 0.3);
        border-color: rgba(139, 92, 246, 0.5);
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 800;
        background: linear-gradient(135deg, #38bdf8, #10b981);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.8rem;
        animation: countUp 2s ease-out;
        text-shadow: 0 0 20px rgba(56, 189, 248, 0.3);
    }

    @keyframes countUp {
        from { opacity: 0; transform: translateY(20px) scale(0.8); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .stat-label {
        font-size: 0.95rem;
        color: #cbd5e1;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    .stat-icon {
        position: absolute;
        top: 1rem;
        right: 1rem;
        width: 24px;
        height: 24px;
        opacity: 0.6;
        color: #8b5cf6;
    }

    /* Enhanced templates section with better positioning */
    .templates-section {
        flex: 1;
        max-width: 1200px;
        margin: 0 auto 4rem auto;
        width: 100%;
        animation: fadeInUp 1s ease-out 0.3s both;
        position: relative;
        z-index: 15;
    }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .templates-title {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
        font-weight: 700;
        font-size: 1.6rem;
        color: #f1f5f9;
        justify-content: center;
        text-shadow: 0 0 20px rgba(139, 92, 246, 0.3);
    }

    .templates-title .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: linear-gradient(135deg, #8b5cf6, #3b82f6);
        box-shadow: 0 0 20px #8b5cf6;
        animation: pulse 2s ease-in-out infinite alternate;
    }

    @keyframes pulse {
        from { opacity: 0.8; transform: scale(1); }
        to { opacity: 1; transform: scale(1.3); }
    }

    .templates-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
        gap: 2rem;
        margin-bottom: 3rem;
        align-items: start;
    }

    .template-card {
        background: linear-gradient(145deg,
            rgba(17, 24, 39, 0.95) 0%,
            rgba(30, 41, 59, 0.85) 100%);
        border: 1px solid rgba(148, 163, 184, 0.25);
        border-radius: 20px;
        padding: 2rem;
        backdrop-filter: blur(25px);
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        height: fit-content;
        min-height: 140px;
        display: flex;
        align-items: center;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    }

    .template-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg,
            transparent,
            rgba(139, 92, 246, 0.8),
            rgba(59, 130, 246, 0.8),
            transparent);
        opacity: 0;
        transition: opacity 0.4s ease;
    }

    .template-card:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 25px 80px rgba(139, 92, 246, 0.4);
        border-color: rgba(139, 92, 246, 0.6);
        background: linear-gradient(145deg,
            rgba(17, 24, 39, 0.98) 0%,
            rgba(30, 41, 59, 0.92) 100%);
    }

    .template-card:hover::before {
        opacity: 1;
    }

    .template-content {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        width: 100%;
        position: relative;
        z-index: 1;
    }

    .template-image {
        width: 80px;
        height: 80px;
        border-radius: 16px;
        flex-shrink: 0;
        background-size: cover;
        background-position: center;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
        position: relative;
        overflow: hidden;
    }

    .template-image::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg,
            rgba(139, 92, 246, 0.2),
            rgba(59, 130, 246, 0.15));
        border-radius: 16px;
    }

    .template-icon {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 2;
        color: white;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
    }

    .template-icon svg {
        width: 32px;
        height: 32px;
    }

    .template-text {
        flex: 1;
    }

    .template-category {
        font-size: 0.8rem;
        color: #93c5fd;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.8px;
        margin-bottom: 0.6rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .feature-tag {
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(59, 130, 246, 0.2));
        color: #c4b5fd;
        padding: 0.2rem 0.6rem;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 600;
        border: 1px solid rgba(139, 92, 246, 0.3);
    }

    .template-title {
        font-size: 1.1rem;
        color: #f9fafb;
        font-weight: 700;
        margin-bottom: 0.8rem;
        line-height: 1.3;
    }

    .template-description {
        font-size: 0.9rem;
        color: #94a3b8;
        line-height: 1.5;
    }

    /* Enhanced Features Section */
    .features-section {
        max-width: 1200px;
        margin: 0 auto 3rem auto;
        width: 100%;
        animation: fadeInUp 1s ease-out 0.4s both;
        position: relative;
        z-index: 15;
    }

    .features-title {
        text-align: center;
        font-size: 2rem;
        font-weight: 800;
        color: #f1f5f9;
        margin-bottom: 2.5rem;
        background: linear-gradient(135deg, #38bdf8, #8b5cf6, #10b981);
        background-size: 200% 200%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: gradientFlow 3s ease-in-out infinite;
        text-shadow: 0 0 30px rgba(139, 92, 246, 0.3);
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2rem;
        margin-bottom: 3rem;
    }

    .feature-card {
        background: linear-gradient(145deg,
            rgba(17, 24, 39, 0.9) 0%,
            rgba(30, 41, 59, 0.8) 100%);
        border: 1px solid rgba(59, 130, 246, 0.25);
        border-radius: 24px;
        padding: 2.5rem;
        text-align: center;
        backdrop-filter: blur(25px);
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.25);
    }

    .feature-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg,
            rgba(139, 92, 246, 0.08) 0%,
            rgba(59, 130, 246, 0.04) 50%,
            rgba(16, 185, 129, 0.08) 100%);
        opacity: 0;
        transition: opacity 0.5s ease;
    }

    .feature-card:hover {
        transform: translateY(-12px) scale(1.03);
        box-shadow: 0 30px 80px rgba(59, 130, 246, 0.35);
        border-color: rgba(59, 130, 246, 0.6);
    }

    .feature-card:hover::before {
        opacity: 1;
    }

    .feature-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 1.8rem;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #3b82f6, #1e40af);
        box-shadow: 0 12px 40px rgba(59, 130, 246, 0.4);
        position: relative;
        z-index: 1;
    }

    .feature-icon svg {
        width: 32px;
        height: 32px;
        color: white;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
    }

    .feature-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #f9fafb;
        margin-bottom: 1.2rem;
        position: relative;
        z-index: 1;
    }

    .feature-description {
        color: #94a3b8;
        line-height: 1.7;
        position: relative;
        z-index: 1;
        font-size: 1rem;
    }

    /* Enhanced Input Section with better visibility */
    .input-section {
        position: fixed;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        width: min(90vw, 900px);
        z-index: 200;
        animation: slideInUp 0.8s ease-out 0.5s both;
    }

    @keyframes slideInUp {
        from { transform: translateX(-50%) translateY(100%); }
        to { transform: translateX(-50%) translateY(0); }
    }

    .input-container {
        position: relative;
        display: flex;
        align-items: center;
        background: linear-gradient(145deg,
            rgba(5, 15, 35, 0.98) 0%,
            rgba(15, 25, 45, 0.95) 50%,
            rgba(5, 15, 35, 0.98) 100%);
        border: 2px solid transparent;
        border-radius: 50px;
        backdrop-filter: blur(30px);
        box-shadow:
            0 20px 80px rgba(0, 0, 0, 0.5),
            inset 0 1px 0 rgba(255, 255, 255, 0.15),
            0 0 0 1px rgba(139, 92, 246, 0.3);
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

    .progress-overlay {
        position: absolute;
        inset: 0;
        background: rgba(139, 92, 246, 0.15);
        border-radius: 50px;
        z-index: 5;
        opacity: 0;
        overflow: hidden;
        transition: opacity 0.3s ease;
    }

    .progress-overlay.active {
        opacity: 1;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg,
            rgba(139, 92, 246, 0.4) 0%,
            rgba(168, 85, 247, 0.5) 50%,
            rgba(139, 92, 246, 0.4) 100%);
        width: 0%;
        border-radius: 50px;
        transition: width 0.15s ease-out;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
        position: relative;
    }

    .progress-fill::after {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 20px;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2));
